root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.{cpp,cppm,ixx,hpp}]
max_line_length = 100

[*.{bat,cmd,ps1,psm1,psd1}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
